# Required by NextAuth and assistant undo signatures.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Admin account created by `npx tsx scripts/seed.ts`.
# SEED_ADMIN_PASSWORD is required and must be at least 12 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Studio Admin
SEED_ADMIN_PASSWORD=
# Optional studio name shown in the UI. Defaults to "Production Planner".
# Can be changed later in Settings → Studio name.
SEED_BUSINESS_NAME=

# Optional shared Gemini fallback key. Personal keys saved in Settings take priority.
GEMINI_API_KEY=

# Required only if signed-in users will save personal Gemini keys.
# Must be at least 32 characters. Changing it later invalidates saved keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GEMINI_KEY_ENCRYPTION_SECRET=
